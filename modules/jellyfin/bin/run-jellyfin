#!/bin/bash
# Run Jellyfin's server for the kit's jellyfin launchd job, which starts it at login and again
# if it crashes. It runs the server inside Jellyfin.app directly, with the arguments the app's
# own menu bar launcher uses (its web pages, its ffmpeg, its data folder), so there's no menu bar
# icon: launchctl kickstart -k gui/$(id -u)/io.github.andy327.mac-server-kit.jellyfin restarts
# it. If Jellyfin is already running, started some other way (the app itself), this watches it
# instead of starting a second one. When the media library is on an external drive, it waits for
# the drive before starting Jellyfin.
#
# Usage: run-jellyfin (launchd runs it; not meant to be run by hand)
#
# Installed by mac-server-kit; ./kit install replaces it.

set -uo pipefail
# shellcheck source=../../core/bin/kit-runtime.sh
. "$(dirname "$0")/kit-runtime.sh"
case "${1:-}" in -h|--help) sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;; esac

APP=$(app_path Jellyfin) || die "Jellyfin isn't installed (looked in $APPS_DIR and /Applications); run ./kit install"
DATA=$(jellyfin_data)
mkdir -p "$DATA"
RUN_AFTER_DRIVES=media-stack run_app "Jellyfin.app/Contents/MacOS/jellyfin( |$)" "$APP/Contents/MacOS/jellyfin" \
    --webdir "$APP/Contents/Resources/jellyfin-web" --ffmpeg "$APP/Contents/MacOS/ffmpeg" --datadir "$DATA"
