# shellcheck shell=bash
# Install Glances (the Mac Host Info widget's data), unless it's already here: with Homebrew when
# it's there, else (or if Homebrew can't) with uv, Astral's standalone Python tool installer, which goes into
# ~/.local/bin and is told not to touch shell profiles (UV_NO_MODIFY_PATH). Never pip --user.
# The kit's glances job runs it (see jobs); update-all updates it (update-glances).

UV=$HOME/.local/bin/uv
UV_INSTALLER=https://astral.sh/uv/install.sh

glances_found() {
    local p prefix=''
    have_brew && prefix=$(kbrew --prefix 2>/dev/null)
    for p in ${KIT_GLANCES_PATHS:-$HOME/.local/bin/glances ${prefix:+$prefix/bin/glances} /opt/homebrew/bin/glances /usr/local/bin/glances}; do
        [ -x "$p" ] && { printf '%s' "$p"; return 0; }
    done
    return 1
}

# Its config, passed with -C (Glances doesn't look for one where macOS keeps settings): the disks
# it reports, which the Mac Host Info widget shows. GLANCES_DISKS, else only this Mac's own disk
# (its data volume, /System/Volumes/Data, not /): the widget has room for one disk next to CPU and
# memory, and check-health already watches the media and games drives' free space.
glances_config() {
    local disks conf=$SERVER_DIR/kit/glances.conf new
    disks=$(answer GLANCES_DISKS 2>/dev/null || true)
    [ -n "$disks" ] || disks=/System/Volumes/Data
    disks=$(printf '%s' "$disks" | tr ',' '\n' | sed 's/^ *//; s/ *$//' | awk 'NF && !seen[$0]++' | paste -sd, -)
    # Glances reads each as a regular expression, matched against the whole mount point
    # shellcheck disable=SC2016  # a sed pattern
    new=$(printf '%s\n' \
        '# Generated by ./kit install (the glances module). Do not edit: set GLANCES_DISKS in' \
        '# answers.conf and run ./kit install.' \
        '[fs]' \
        "show=$(printf '%s' "$disks" | sed 's/[][\.*^$()+?{}|]/\\&/g')")
    if [ -f "$conf" ] && [ "$(cat "$conf")" = "$new" ]; then
        note "Glances: reports $disks (already set)"
        return 0
    fi
    printf '%s\n' "$new" | write_generated "$conf"
    ok "Glances: reports $disks"
    # A running Glances reads its config only when it starts
    klaunchctl kickstart -k "gui/$(id -u)/$KIT_JOB_PREFIX.glances" >/dev/null 2>&1 || true
}
# Glances started some other way (a login item of its own, like an older setup's) runs without
# the kit's config; the kit's job only watches it then
glances_other_job() {
    local other
    other=$(klaunchctl list 2>/dev/null | awk '{ print $3 }' | grep -i glances | grep -vF "$KIT_JOB_PREFIX." | head -n 1)
    [ -z "$other" ] || warn "Glances: another launchd job runs it ($other), without the kit's settings. Remove it (launchctl bootout gui/$(id -u)/$other, then delete its plist from ~/Library/LaunchAgents) and run ./kit install."
}

if g=$(glances_found); then
    note "Glances: $(tilde "$g") (already installed)"
    glances_config
    glances_other_job
    return 0
fi
if have_brew; then
    note "Glances: installing with Homebrew"
    kbrew install glances >/dev/null 2>&1 ||
        note "Glances: Homebrew couldn't install it (another account's Homebrew?); using uv instead"
fi
if ! glances_found >/dev/null; then
    if [ ! -x "$UV" ]; then
        note "Glances: installing uv first (into ~/.local/bin)"
        kcurl -fsSL --max-time 120 "$UV_INSTALLER" 2>/dev/null | UV_NO_MODIFY_PATH=1 sh >/dev/null 2>&1 ||
            NATIVE_ERR="uv's installer ($UV_INSTALLER) failed"
    fi
    if [ -x "$UV" ]; then
        note "Glances: installing with uv"
        "$UV" tool install 'glances[web]' >/dev/null 2>&1 || NATIVE_ERR="uv tool install glances failed"
    fi
fi
if g=$(glances_found); then
    ok "Glances: $(tilde "$g")"
    glances_config
else
    warn "Glances wasn't installed: ${NATIVE_ERR:-not found after installing}. The Mac Host Info widget stays empty until it is; run ./kit install again to retry."
fi
return 0
