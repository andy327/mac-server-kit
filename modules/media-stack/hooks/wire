# shellcheck shell=bash
# Connect the media apps through their APIs, after they've started: the settings that live in
# their databases, and the Homarr tiles. Each thing is looked up first and created only if
# missing; a failed step warns and the rest go on. Calls checked against Sonarr 4.0, Radarr 5,
# Prowlarr 1, Seerr 3 and Homarr 2.3.
# The apps talk to each other by service name on the compose network (sonarr:8989, ...); the kit
# talks to them on this Mac (127.0.0.1).

A=$(project_appdata media-stack)
SONARR=http://127.0.0.1:8989
RADARR=http://127.0.0.1:7878
PROWLARR=http://127.0.0.1:9696
SEERR=http://127.0.0.1:5055

arr_key() {         # app -> the API key in its config.xml (seeded, or the app's own)
    xml_value "$A/$1/config.xml" ApiKey
}
SK=$(arr_key sonarr)
RK=$(arr_key radarr)
PK=$(arr_key prowlarr)
QBPW=$(json_str "$(secret QBITTORRENT_PASSWORD)")
if in_plan && { [ -z "$SK" ] || [ -z "$RK" ] || [ -z "$PK" ]; }; then
    plan_cant "the media apps' settings: no config.xml with their keys in $(tilde "$A") yet (the install seeds one, so they start as new apps)"
    return 0
fi

# ---- Sonarr and Radarr: where the library lives, and qBittorrent as the download client. The
# client is reached as gluetun:8080 (qBittorrent shares Gluetun's network); the apps log in to
# check it when it's added, so this also proves the seeded password and categories.
qbittorrent_client() {     # category-field category
    printf '{"enable":true,"protocol":"torrent","priority":1,"name":"qBittorrent","implementation":"QBittorrent",'
    printf '"configContract":"QBittorrentSettings","fields":[{"name":"host","value":"gluetun"},'
    printf '{"name":"port","value":8080},{"name":"useSsl","value":false},{"name":"username","value":"admin"},'
    printf '{"name":"password","value":"%s"},{"name":"%s","value":"%s"}],' "$QBPW" "$1" "$2"
    printf '"removeCompletedDownloads":true,"removeFailedDownloads":true,"tags":[]}'
}
api_ensure "Sonarr: library folder /data/TV Shows" "$SONARR/api/v3/rootfolder" "$SK" '"path":"/data/TV Shows"' '{"path":"/data/TV Shows"}'
api_ensure "Sonarr: qBittorrent as its download client" "$SONARR/api/v3/downloadclient" "$SK" \
    '"name":"qBittorrent"' "$(qbittorrent_client tvCategory tv-sonarr)"
api_ensure "Radarr: library folder /data/Movies" "$RADARR/api/v3/rootfolder" "$RK" '"path":"/data/Movies"' '{"path":"/data/Movies"}'
api_ensure "Radarr: qBittorrent as its download client" "$RADARR/api/v3/downloadclient" "$RK" \
    '"name":"qBittorrent"' "$(qbittorrent_client movieCategory radarr)"

# ---- The /data layout. Kit installs before it mounted /tv, /movies and /downloads separately,
# so imports were copies, not hardlinks. Now everything is under /data: the same files at a new
# path. Each app's records move over through its own API (nothing on disk moves), then the old
# root folder goes. Nothing happens once no old root folder is left.
TAB=$(printf '\t')
arr_rebase_list() { # App api-url key what old new: PUT each item of what that names a path under old
    local id json
    api_call GET "$2/$4" "$3" || return 0
    api_rebase "$5" "$6" | while IFS="$TAB" read -r id json; do
        [ -n "$id" ] || continue
        if api_call PUT "$2/$4/$id?forceSave=true" "$3" "$json"; then
            ok "$1: $4 $id now uses $6"
        else
            warn "$1: couldn't move $4 $id to $6 ($(api_error)); change it in $1's settings"
        fi
    done
}
arr_move_root() {   # App api-url key old new items(series|movie) ids-key
    local app=$1 url=$2 key=$3 old=$4 new=$5 items=$6 idkey=$7 oldid ids n x
    api_call GET "$url/rootfolder" "$key" || return 0
    oldid=$(api_id_of path "$old")
    [ -n "$oldid" ] || return 0
    info "$app: moving its library from $old to $new (the files stay where they are)"
    if ! api_call GET "$url/$items" "$key"; then
        warn "$app: couldn't read its library ($(api_error)); run ./kit install again"
        WIRE_WARNINGS=$((WIRE_WARNINGS + 1))
        return 0
    fi
    ids=$(api_ids_under path "$old")
    if [ -n "$ids" ]; then
        n=$(printf '%s' "$ids" | tr ',' '\n' | grep -c .)
        if api_call PUT "$url/$items/editor" "$key" "{\"$idkey\":[$ids],\"rootFolderPath\":\"$new\",\"moveFiles\":false}"; then
            ok "$app: $n in its library now under $new"
            ! in_plan || plan_flag "$app: $n in its library would move from $old to $new (their paths only, no files move; $app then rescans each one's folder)"
        else
            warn "$app: couldn't move its library to $new ($(api_error)); run ./kit install again"
            WIRE_WARNINGS=$((WIRE_WARNINGS + 1))
            return 0
        fi
    fi
    # Radarr's collections and both apps' import lists have their own root folder; Plex and
    # Jellyfin connections map the old path to this Mac's
    for x in collection importlist notification; do
        [ "$x" = collection ] && [ "$items" != movie ] && continue
        arr_rebase_list "$app" "$url" "$key" "$x" "$old" "$new"
    done
    if in_plan; then
        ok "$app: remove the old library folder $old (once nothing is left under it)"
        return 0
    fi
    # Only when nothing is left under the old folder
    if ! api_call GET "$url/$items" "$key" || [ -n "$(api_ids_under path "$old")" ]; then
        warn "$app: some of its library is still under $old; its root folder stays. Run ./kit install again"
        WIRE_WARNINGS=$((WIRE_WARNINGS + 1))
        return 0
    fi
    if api_call DELETE "$url/rootfolder/$oldid" "$key"; then
        ok "$app: removed the old library folder $old"
    else
        warn "$app: couldn't remove the old library folder $old ($(api_error)); remove it under Settings → Media Management"
    fi
}
arr_move_root Sonarr "$SONARR/api/v3" "$SK" /tv "/data/TV Shows" series seriesIds
arr_move_root Radarr "$RADARR/api/v3" "$RK" /movies /data/Movies movie movieIds

# A plan's check: library folders outside /tv, /movies and /data, which a container mounting only
# /data wouldn't see
if in_plan; then
    for app in Sonarr:8989:"$SK" Radarr:7878:"$RK"; do
        IFS=: read -r name port key <<EOF
$app
EOF
        api_call GET "http://127.0.0.1:$port/api/v3/rootfolder" "$key" || continue
        printf '%s' "$API_BODY" | json_flat | grep -o '"path":"[^"]*"' | sed 's/^"path":"//; s/"$//' | while IFS= read -r path; do
            case "$path" in /tv|/tv/*|/movies|/movies/*|/data|/data/*) continue ;; esac
            plan_flag "$name: its library folder $path isn't under /data, and the kit's $name mounts only /data (unless compose.override.yml mounts $path, $name loses sight of what's there)"
        done
    done
fi

# Hardlinks: the apps' default. Only said when someone turned it off (it's their setting).
for app in Sonarr:"$SONARR":"$SK" Radarr:"$RADARR":"$RK"; do
    IFS=: read -r name _ _ port key <<EOF
$app
EOF
    if api_call GET "http://127.0.0.1:$port/api/v3/config/mediamanagement" "$key" && \
        printf '%s' "$API_BODY" | json_flat | grep -qF '"copyUsingHardlinks":false'; then
        warn "$name: imports are copies, not hardlinks (twice the space). Turn on Settings → Media Management → Use Hardlinks instead of Copy (Show Advanced)"
    fi
done

# qBittorrent: its seeded paths were /downloads/...; an older install's settings, categories and
# torrents move to /data/Downloads/... (the same folders). This Mac needs no sign-in (the seeded
# AuthSubnetWhitelist); if that doesn't hold (a qBittorrent.conf from before), it signs in as admin.
QBURL=http://127.0.0.1:8080
qb_call() {         # path [curl data args...] -> 0 on a 2xx answer; API_BODY
    local out
    # A plan reads only: a sign-in isn't tried, and a change answers as if it worked
    if in_plan && [ $# -gt 1 ]; then
        case "$1" in auth/login) API_STATUS='not tried in a plan'; return 1 ;; esac
        API_STATUS=200 API_BODY=''
        return 0
    fi
    out=$(kcurl -sS --max-time 30 -b "$QBJAR" -c "$QBJAR" -w '\n%{http_code}' "${@:2}" "$QBURL/api/v2/$1" 2>/dev/null) || return 1
    API_STATUS=${out##*$'\n'}
    API_BODY=${out%$'\n'*}
    case "$API_STATUS" in 2??) return 0 ;; esac
    return 1
}
QBJAR=$(mktemp "${TMPDIR:-/tmp}/kit-qb.XXXXXX")
qb_in=''
if qb_call app/preferences; then
    qb_in=1
else
    qb_why="settings: ${API_STATUS:-no answer}"
    if ! qb_call auth/login --data-urlencode username=admin --data-urlencode "password=$(secret QBITTORRENT_PASSWORD)"; then
        qb_why="$qb_why; sign-in: ${API_STATUS:-no answer}"
    elif [ "$API_BODY" != Ok. ]; then
        qb_why="$qb_why; sign-in refused, so QBITTORRENT_PASSWORD isn't its password"
    elif qb_call app/preferences; then
        qb_in=1
    else
        qb_why="settings after signing in: ${API_STATUS:-no answer}"
    fi
fi
if [ -n "$qb_in" ]; then
    prefs=$(printf '%s' "$API_BODY" | json_flat)
    case "$prefs" in *'"save_path":"/downloads'*|*'"temp_path":"/downloads'*)
        if qb_call app/setPreferences --data-urlencode 'json={"save_path":"/data/Downloads/complete","temp_path":"/data/Downloads/incomplete"}'; then
            ok "qBittorrent: download folders now /data/Downloads/complete and incomplete"
        else
            warn "qBittorrent: couldn't change its download folders to /data/Downloads ($API_STATUS); change them under Options → Downloads"
        fi ;;
    *'"save_path":"/data/'*) note "qBittorrent: download folders under /data/Downloads (already set)" ;;
    esac
    if qb_call torrents/categories; then
        api_js 'return Object.keys(d).filter(function (k) { var p = d[k].savePath || ""; return p === "/downloads" || p.indexOf("/downloads/") === 0; })
            .map(function (k) { return k + "\t/data/Downloads" + d[k].savePath.slice(10); }).join("\n");' |
            while IFS="$TAB" read -r cat path; do
                [ -n "$cat" ] || continue
                qb_call torrents/editCategory --data-urlencode "category=$cat" --data-urlencode "savePath=$path" &&
                    ok "qBittorrent: category $cat now saves to $path"
            done
    fi
    if qb_call torrents/info; then
        moved=$(api_js 'return d.filter(function (t) { var p = t.save_path || ""; return p === "/downloads" || p.indexOf("/downloads/") === 0; })
            .map(function (t) { return t.hash + "\t/data/Downloads" + t.save_path.slice(10); }).join("\n");')
        if [ -n "$moved" ]; then
            printf '%s\n' "$moved" | while IFS="$TAB" read -r hash path; do
                qb_call torrents/setLocation --data-urlencode "hashes=$hash" --data-urlencode "location=$path" &&
                    qb_call torrents/recheck --data-urlencode "hashes=$hash"
            done
            ok "qBittorrent: $(printf '%s\n' "$moved" | grep -c .) torrents now in /data/Downloads (rechecked)"
            ! in_plan || plan_flag "qBittorrent: $(printf '%s\n' "$moved" | grep -c .) torrents would move to /data/Downloads and be rechecked (qBittorrent reads every one of their files again)"
        fi
    fi
else
    warn "qBittorrent: couldn't reach its settings from this Mac ($qb_why), so its download folders weren't checked. Under Options → Downloads they should be /data/Downloads/complete and /data/Downloads/incomplete"
fi
rm -f "$QBJAR"

# ---- Prowlarr: a "flaresolverr" tag, the FlareSolverr proxy for indexers carrying it, and
# Sonarr and Radarr as apps, so every indexer added in Prowlarr reaches both. The sync categories
# are the reference stack's (Prowlarr's own defaults leave out anime, sport and documentaries).
api_ensure "Prowlarr: flaresolverr tag" "$PROWLARR/api/v1/tag" "$PK" '"label":"flaresolverr"' \
    '{"label":"flaresolverr"}'
tag=''
api_call GET "$PROWLARR/api/v1/tag" "$PK" && tag=$(api_id_of label flaresolverr)
if [ -n "$tag" ]; then
    api_ensure "Prowlarr: FlareSolverr proxy (for indexers tagged flaresolverr)" "$PROWLARR/api/v1/indexerProxy" "$PK" \
        '"name":"FlareSolverr"' \
        "{\"name\":\"FlareSolverr\",\"implementation\":\"FlareSolverr\",\"configContract\":\"FlareSolverrSettings\",\"fields\":[{\"name\":\"host\",\"value\":\"http://flaresolverr:8191/\"},{\"name\":\"requestTimeout\",\"value\":60}],\"tags\":[$tag]}"
elif in_plan; then
    ok "Prowlarr: FlareSolverr proxy (for indexers tagged flaresolverr)"
else
    warn "Prowlarr: no flaresolverr tag to put on the FlareSolverr proxy; add the proxy by hand"
    WIRE_WARNINGS=$((WIRE_WARNINGS + 1))
fi
prowlarr_app() {    # Name port key categories
    local lower
    lower=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
    printf '{"name":"%s","implementation":"%s","configContract":"%sSettings","syncLevel":"fullSync",' "$1" "$1" "$1"
    printf '"fields":[{"name":"prowlarrUrl","value":"http://prowlarr:9696"},{"name":"baseUrl","value":"http://%s:%s"},' "$lower" "$2"
    printf '{"name":"apiKey","value":"%s"},{"name":"syncCategories","value":[%s]}],"tags":[]}' "$3" "$4"
}
api_ensure "Prowlarr: Sonarr as an app (indexers sync to it)" "$PROWLARR/api/v1/applications" "$PK" \
    '"name":"Sonarr"' "$(prowlarr_app Sonarr 8989 "$SK" 5000,5010,5020,5030,5040,5045,5050,5060,5070,5080)"
api_ensure "Prowlarr: Radarr as an app (indexers sync to it)" "$PROWLARR/api/v1/applications" "$PK" \
    '"name":"Radarr"' "$(prowlarr_app Radarr 7878 "$RK" 2000,2010,2020,2030,2040,2045,2050,2060,2070,2080)"
# Whether Prowlarr has indexers yet, for the Still to do list (left as it was if Prowlarr doesn't
# answer)
if api_call GET "$PROWLARR/api/v1/indexer" "$PK"; then
    case "$API_BODY" in *'"id"'*) todo_mark prowlarr-indexers yes ;; *) todo_mark prowlarr-indexers no ;; esac
fi

# ---- Logins: Sonarr, Radarr and Prowlarr insist on one before their pages open. The kit makes it
# the way their "Authentication Required" box does, through their host settings: a login page,
# user admin, the generated ARR_PASSWORD. A login someone already made is left alone.
ARRPW=$(secret ARR_PASSWORD || true)
arr_login() {       # Name api-base key
    local body id new
    if ! api_call GET "$2/config/host" "$3"; then
        warn "$1: couldn't read its login settings ($(api_error)); it asks you to make a login the first time you open it"
        WIRE_WARNINGS=$((WIRE_WARNINGS + 1))
        return 1
    fi
    body=$(printf '%s' "$API_BODY" | json_flat)
    case "$body" in
        *'"username":""'*|*'"username":null'*) ;;
        *'"username":"'*) note "$1: login (already set)"; return 0 ;;
    esac
    id=$(printf '%s' "$body" | sed -n 's/.*"id":\([0-9][0-9]*\)[,}].*/\1/p')
    case "$body" in *'"passwordConfirmation":'*) ;; *) body="${body%\}},\"passwordConfirmation\":\"\"}" ;; esac
    # Their whole host settings back, with the login set (ARR_PASSWORD has only letters, digits, -)
    new=$(printf '%s' "$body" | sed -E -e 's/"authenticationMethod":"[^"]*"/"authenticationMethod":"forms"/' \
        -e 's/"authenticationRequired":"[^"]*"/"authenticationRequired":"enabled"/' \
        -e 's/"username":(""|null)/"username":"admin"/' \
        -e "s/\"password\":(\"[^\"]*\"|null)/\"password\":\"$ARRPW\"/" \
        -e "s/\"passwordConfirmation\":(\"[^\"]*\"|null)/\"passwordConfirmation\":\"$ARRPW\"/")
    if api_call PUT "$2/config/host${id:+/$id}" "$3" "$new"; then
        ok "$1: login (admin, with ARR_PASSWORD)"
    else
        warn "$1: login: $(api_error); it asks you to make one the first time you open it"
        WIRE_WARNINGS=$((WIRE_WARNINGS + 1))
    fi
}
arr_login Sonarr "$SONARR/api/v3" "$SK"
arr_login Radarr "$RADARR/api/v3" "$RK"
arr_login Prowlarr "$PROWLARR/api/v1" "$PK"

# ---- Seerr: once someone has signed in (its API refuses its own key before that), connect it
# to Sonarr and Radarr: their first quality profile and the library folders. Before sign-in this
# only says so; the next ./kit install does it.
seerr_service() {   # app port key folder -> Seerr's JSON for that service, using its own test call
    local profile pname extra=''
    api_call POST "$SEERR/api/v1/settings/$1/test" "$SEERRK" \
        "{\"hostname\":\"$1\",\"port\":$2,\"apiKey\":\"$3\",\"useSsl\":false}" || return 1
    # The first profile. Its items nest qualities with their own "id" and "name", so not sed.
    profile=$(api_value profiles.0.id)
    pname=$(json_str "$(api_value profiles.0.name)")
    [ -n "$profile" ] && [ -n "$pname" ] || return 1
    # Seerr's API requires activeProfileName, and Radarr's minimumAvailability, Sonarr's enableSeasonFolders
    if [ "$1" = sonarr ]; then
        extra=",\"activeAnimeProfileId\":$profile,\"activeAnimeProfileName\":\"$pname\",\"activeAnimeDirectory\":\"$4\",\"enableSeasonFolders\":true"
    else
        extra=",\"minimumAvailability\":\"released\""
    fi
    printf '{"name":"%s","hostname":"%s","port":%s,"apiKey":"%s","useSsl":false,"activeProfileId":%s,"activeProfileName":"%s","activeDirectory":"%s","is4k":false,"isDefault":true,"syncEnabled":true,"externalUrl":"http://localhost:%s"%s}' \
        "$(printf '%s' "$1" | sed 's/^s/S/; s/^r/R/')" "$1" "$2" "$3" "$profile" "$pname" "$4" "$2" "$extra"
}
SEERRK=$(sed -n 's/.*"apiKey": *"\([^"]*\)".*/\1/p' "$A/seerr/settings.json" 2>/dev/null | head -n 1)
SEERR_READY=no
if api_call GET "$SEERR/api/v1/settings/public" '' && printf '%s' "$API_BODY" | json_flat | grep -qF '"initialized":true' \
    && [ -n "$SEERRK" ]; then
    SEERR_READY=yes
fi
todo_mark seerr-setup "$SEERR_READY"
if [ "$SEERR_READY" = no ]; then
    note "Seerr: not set up yet. After you sign in to it, ./kit install connects it to Sonarr and Radarr."
else
    while IFS=: read -r name port key folder; do
        [ -n "$name" ] || continue
        if in_plan; then    # its profiles come from a test call (a POST), which a plan doesn't make
            api_ensure "Seerr: $name for requests" "$SEERR/api/v1/settings/$name" "$SEERRK" "\"hostname\":\"$name\"" '{}'
            continue
        fi
        if ! body=$(seerr_service "$name" "$port" "$key" "$folder"); then
            warn "Seerr: couldn't read $name's quality profiles ($(api_error)); connect it in Seerr's settings"
            WIRE_WARNINGS=$((WIRE_WARNINGS + 1))
            continue
        fi
        api_ensure "Seerr: $name for requests" "$SEERR/api/v1/settings/$name" "$SEERRK" "\"hostname\":\"$name\"" "$body"
        # Its library folder: an older install's /tv or /movies, or one left empty when that
        # folder went (requests then stop reaching the app, with no error). Seerr refuses a body
        # with its read-only id.
        old=/movies
        [ "$name" = sonarr ] && old=/tv
        if api_call GET "$SEERR/api/v1/settings/$name" "$SEERRK"; then
            api_rebase "$old" "$folder" activeDirectory,activeAnimeDirectory id | while IFS="$TAB" read -r id json; do
                [ -n "$id" ] || continue
                if api_call PUT "$SEERR/api/v1/settings/$name/$id" "$SEERRK" "$json"; then
                    ok "Seerr: $name's library folder is $folder"
                else
                    warn "Seerr: couldn't set $name's library folder to $folder ($(api_error)); pick it in Seerr → Settings → Services"
                fi
            done
        fi
    done <<EOF
sonarr:8989:$SK:/data/TV Shows
radarr:7878:$RK:/data/Movies
EOF
fi

# ---- Homarr: a tile for each app (opening its Tailscale address, or this Mac's when the node
# isn't up), and with it the widget connection. Homarr reaches the apps on the compose network.
# Seerr's widget waits until someone has signed in to Seerr (its key works only then).
tile_href() {       # port local-port -> the address a tile opens
    local u
    u=$(ts_url media "$1")
    printf '%s' "${u:-http://localhost:$2}"
}
BK=$(awk '/^auth:/ { a = 1; next } /^[^ ]/ { a = 0 } a && /^  apikey:/ { v = $2; gsub(/'\''/, "", v); print v; exit }' \
    "$A/bazarr/config/config.yaml" 2>/dev/null)
if homarr_prepare; then
    seerr_kind='' seerr_secret=''
    [ "$SEERR_READY" = no ] || { seerr_kind=seerr; seerr_secret=$(homarr_secret apiKey "$SEERRK"); }
    homarr_app Seerr "Requests" seerr "$(tile_href 443 5055)" http://seerr:5055 \
        "$seerr_kind" http://seerr:5055 "$seerr_secret"
    homarr_app Sonarr "TV shows" sonarr "$(tile_href 8989 8989)" http://sonarr:8989 \
        sonarr http://sonarr:8989 "$(homarr_secret apiKey "$SK")"
    homarr_app Radarr "Movies" radarr "$(tile_href 7878 7878)" http://radarr:7878 \
        radarr http://radarr:7878 "$(homarr_secret apiKey "$RK")"
    homarr_app Prowlarr "Indexers" prowlarr "$(tile_href 9696 9696)" http://prowlarr:9696 \
        prowlarr http://prowlarr:9696 "$(homarr_secret apiKey "$PK")"
    if [ -n "$BK" ]; then
        homarr_app Bazarr "Subtitles" bazarr "$(tile_href 6767 6767)" http://bazarr:6767 \
            bazarr http://bazarr:6767 "$(homarr_secret apiKey "$BK")"
    fi
    homarr_app qBittorrent "Downloads, through the VPN" qbittorrent "$(tile_href 8080 8080)" http://gluetun:8080 \
        qBittorrent http://gluetun:8080 "$(homarr_secret username admin),$(homarr_secret password "$(secret QBITTORRENT_PASSWORD)")"
    homarr_app Gluetun "" gluetun "" "" \
        gluetun http://gluetun:8000 "$(homarr_secret apiKey "$(secret GLUETUN_CONTROL_API_KEY)")"
fi

if [ "$WIRE_WARNINGS" -gt 0 ]; then
    warn "$WIRE_WARNINGS app setting(s) couldn't be made (above). The apps run; set those by hand, or run ./kit install again."
fi
return 0
