# KEY|value|when: the lines this module puts in ~/server/media-stack/.env (generated on every
# install, private). ${NAME} is an answer, a secret or a generated secret; KIT_PUID, KIT_PGID
# (this Mac's user and group) and KIT_APPDATA (this project's app data folder) come from the kit.
# "when" is a condition, as in prompts files.
TIMEZONE|${TIMEZONE}|
PUID|${KIT_PUID}|
PGID|${KIT_PGID}|
MEDIA_ROOT|${MEDIA_ROOT}|
APPDATA|${KIT_APPDATA}|
MEDIA_SUBNET|${MEDIA_SUBNET}|
VPN_SERVICE_PROVIDER|${VPN_PROVIDER}|
VPN_PORT_FORWARDING|on|VPN_PROVIDER=protonvpn
VPN_PORT_FORWARDING|off|VPN_PROVIDER!=protonvpn
SERVER_COUNTRIES|${VPN_COUNTRIES}|
WIREGUARD_PRIVATE_KEY|${WIREGUARD_PRIVATE_KEY}|
GLUETUN_CONTROL_API_KEY|${GLUETUN_CONTROL_API_KEY}|
HOMARR_SECRET_ENCRYPTION_KEY|${HOMARR_SECRET_ENCRYPTION_KEY}|
TS_AUTHKEY|${TS_AUTHKEY}|
TS_HOSTNAME_MEDIA|${TS_NODE_media}|
TS_HOSTNAME_DASHBOARD|${TS_NODE_dashboard}|
