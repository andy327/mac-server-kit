# shellcheck shell=bash
# RomM's library folders: roms/<platform> and bios/<platform> under GAMES_ROOT for each of
# ROMM_PLATFORMS (RomM's "Structure A"). Made only if missing; a platform taken off the list keeps
# its folders. No RomM settings are seeded: it runs with its stock config.
#
# A library already laid out the other way (<platform>/roms, RomM's "Structure B") is left alone:
# RomM takes a roms/ folder at the top to mean Structure A, so making one would hide every game
# at its next scan.

games=$(media_folder GAMES_ROOT) || exit 1     # it said why
structure_b=''
if [ ! -d "$games/roms" ]; then
    for d in "$games"/*/roms; do [ -d "$d" ] && { structure_b=$d; break; }; done
fi
n=0 made=''
for p in $(answer ROMM_PLATFORMS | tr ',' ' '); do
    n=$((n + 1))
    [ -z "$structure_b" ] || continue
    for d in "roms/$p" "bios/$p"; do
        [ -d "$games/$d" ] && continue
        make_dir "$games/$d" quiet
        made=$(list_add "$made" "$p")
    done
done
for d in assets config resources redis mariadb; do
    make_dir "$(project_appdata romm)/$d" quiet
done
if [ -n "$structure_b" ]; then
    msg="$(media_folder_label GAMES_ROOT "$games") is laid out as <platform>/roms ($(tilde "$structure_b")), RomM's Structure B, so the kit makes no roms/ or bios/ folders there: a roms/ folder at the top would switch RomM to Structure A and hide your games."
    if in_plan; then plan_flag "Games: $msg"; else warn "Games: $msg"; fi
elif [ -n "$made" ]; then
    ok "Games: $(media_folder_label GAMES_ROOT "$games") (new platform folders: $made)"
else
    note "Games: $(media_folder_label GAMES_ROOT "$games") ($n platforms' folders already there; add more in ROMM_PLATFORMS)"
fi
