# shellcheck shell=bash
# RomM's library folders: roms/<platform> and bios/<platform> under GAMES_ROOT for each of
# ROMM_PLATFORMS (RomM's "Structure A"). Made only if missing; a platform taken off the list keeps
# its folders. No RomM settings are seeded: it runs with its stock config.

games=$(media_folder GAMES_ROOT)
n=0 made=''
for p in $(answer ROMM_PLATFORMS | tr ',' ' '); do
    n=$((n + 1))
    for d in "roms/$p" "bios/$p"; do
        [ -d "$games/$d" ] && continue
        mkdir -p "$games/$d" || die "could not create $games/$d"
        made=$(list_add "$made" "$p")
    done
done
for d in assets config resources redis mariadb; do
    mkdir -p "$(project_appdata romm)/$d" || die "could not create $(project_appdata romm)/$d"
done
if [ -n "$made" ]; then
    ok "Games: $(media_folder_label GAMES_ROOT "$games") (new platform folders: $made)"
else
    note "Games: $(media_folder_label GAMES_ROOT "$games") ($n platforms' folders already there; add more in ROMM_PLATFORMS)"
fi
