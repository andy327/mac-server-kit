# shellcheck shell=bash
# Download OLLAMA_MODEL once Ollama answers (the kit's ollama job started it earlier in the
# install), unless it's already here or the answer is none.

OL=http://127.0.0.1:11434
model=$(answer OLLAMA_MODEL || true)
ollama_path "$(apps_dir)" >/dev/null || return 0     # not installed (its install hook said why)
i=0
until [ "$(kcurl -fsS --max-time 5 "$OL/api/version" 2>/dev/null | grep -c '"version"')" -gt 0 ]; do
    i=$((i + 1))
    if [ "$i" -ge "${KIT_OLLAMA_WAIT:-30}" ]; then
        warn "Ollama: not answering on port 11434 (its log: ~/server/logs/ollama.log); run ./kit install again to download ${model:-its model}"
        WIRE_WARNINGS=$((WIRE_WARNINGS + 1))
        return 0
    fi
    sleep 2
done
case "$model" in ''|none) return 0 ;; esac
case "$model" in *:*) want=$model ;; *) want=$model:latest ;; esac
if kcurl -fsS --max-time 10 "$OL/api/tags" 2>/dev/null | json_flat | grep -qF "\"name\":\"$want\""; then
    note "Ollama: $model (already downloaded)"
    return 0
fi
note "Ollama: downloading $model (several GB; this can take a while)"
if out=$(kcurl -sS --max-time 7200 -X POST -H 'Content-Type: application/json' \
        --data "{\"model\":\"$(json_str "$model")\",\"stream\":false}" "$OL/api/pull" 2>&1) &&
    printf '%s' "$out" | grep -qF '"status":"success"'; then
    ok "Ollama: $model"
else
    warn "Ollama: couldn't download $model ($(printf '%s' "$out" | sed -n 's/.*"error":"\([^"]*\)".*/\1/p' | head -n 1)); try ollama pull $model, or set another OLLAMA_MODEL in $(shown "$ANSWERS")"
    WIRE_WARNINGS=$((WIRE_WARNINGS + 1))
fi
return 0
