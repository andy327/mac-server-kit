# shellcheck shell=bash
# Connect the media stack to Plex once someone has signed in to it (its sign-in token, in Plex's
# own preferences, appears only then): Sonarr and Radarr tell Plex to rescan what they import,
# and Homarr gets a Plex tile and widget connection. All of them reach Plex through plex-proxy
# (compose.media-stack.yml). Before sign-in the install only says so; the next run connects it.
# Looked up first and created only if missing; a failed step warns and the rest go on.

PLEX_TOKEN=$("${KIT_DEFAULTS:-defaults}" read com.plexapp.plexmediaserver PlexOnlineToken 2>/dev/null || true)
if [ -z "$PLEX_TOKEN" ]; then
    todo_mark plex-libraries no
    note "Plex: not signed in yet. After you sign in (http://localhost:32400/web), ./kit install connects Sonarr, Radarr and Homarr to it."
    return 0
fi

A=$(project_appdata media-stack)
SK=$(xml_value "$A/sonarr/config.xml" ApiKey)
RK=$(xml_value "$A/radarr/config.xml" ApiKey)
MEDIA=$(answer MEDIA_ROOT)

# Sonarr's and Radarr's "Plex Media Server" connection. They see the library as /data/TV Shows
# and /data/Movies; Plex sees the same folders on this Mac, so the paths are mapped for its rescans.
plex_connection() {     # path-in-the-app path-on-this-Mac
    printf '{"name":"Plex","implementation":"PlexServer","configContract":"PlexServerSettings",'
    printf '"onDownload":true,"onUpgrade":true,"onImportComplete":true,"onRename":true,'
    printf '"onSeriesDelete":true,"onEpisodeFileDelete":true,"onEpisodeFileDeleteForUpgrade":true,'
    printf '"onMovieDelete":true,"onMovieFileDelete":true,"onMovieFileDeleteForUpgrade":true,'
    printf '"fields":[{"name":"host","value":"plex-proxy"},{"name":"port","value":32400},'
    printf '{"name":"useSsl","value":false},{"name":"authToken","value":"%s"},' "$(json_str "$PLEX_TOKEN")"
    printf '{"name":"updateLibrary","value":true},{"name":"mapFrom","value":"%s"},{"name":"mapTo","value":"%s"}],' \
        "$1" "$(json_str "$2")"
    printf '"tags":[]}'
}
# Sonarr and Radarr refuse the connection until Plex has a library of their kind (HTTP 400, "At
# least one TV library is required"), so wait for one. If Plex doesn't answer, try anyway: the
# warning then says why.
PLEX_SECTIONS=$(kcurl -fsS --max-time 10 -H "X-Plex-Token: $PLEX_TOKEN" -H 'Accept: application/xml' \
    http://127.0.0.1:32400/library/sections 2>/dev/null) || PLEX_SECTIONS=unknown
plex_has() {        # show|movie
    [ "$PLEX_SECTIONS" = unknown ] || printf '%s' "$PLEX_SECTIONS" | grep -q "type=\"$1\""
}
# Signed in with both libraries: plex's to-do is done (left as it was if Plex doesn't answer)
if [ "$PLEX_SECTIONS" != unknown ]; then
    if plex_has show && plex_has movie; then todo_mark plex-libraries yes; else todo_mark plex-libraries no; fi
fi
if plex_has show; then
    api_ensure "Sonarr: Plex library updates" "http://127.0.0.1:8989/api/v3/notification" "$SK" \
        '"implementation":"PlexServer"' "$(plex_connection "/data/TV Shows" "$MEDIA/TV Shows")"
else
    note "Sonarr: Plex has no TV library yet. Add one ($(tilde "$MEDIA/TV Shows")), then ./kit install connects Sonarr to it."
fi
if plex_has movie; then
    api_ensure "Radarr: Plex library updates" "http://127.0.0.1:7878/api/v3/notification" "$RK" \
        '"implementation":"PlexServer"' "$(plex_connection /data/Movies "$MEDIA/Movies")"
else
    note "Radarr: Plex has no Movies library yet. Add one ($(tilde "$MEDIA/Movies")), then ./kit install connects Radarr to it."
fi

if homarr_prepare; then
    homarr_app Plex "Movies and TV" plex "https://app.plex.tv/desktop" http://plex-proxy:32400/identity \
        plex http://plex-proxy:32400 "$(homarr_secret apiKey "$PLEX_TOKEN")"
fi
return 0
