#!/bin/bash
# Stand-ins for the commands check-health asks about the Mac, so its tests don't depend on the
# machine running them. tests/test-health.sh links each command's name to this file, in a folder
# put first on check-health's PATH (KIT_TEST_PATH). One healthy Mac, except:
#   FAKE_HOST_DOCKER=down   OrbStack stopped, Docker not answering
#   FAKE_HOST_DISK=<pct>    percent of the disk in use (default 40)
#   FAKE_HOST_BATTERY=1     a laptop running on battery
#   FAKE_HOST_GW=<address>  the default gateway (default 192.168.1.1)
#   FAKE_HOST_IF=<device>   the default route's interface (default en5, the Ethernet port; Wi-Fi is en0)
#   FAKE_HOST_UP=<devices>  interfaces connected (default en5)
#   FAKE_HOST_SLEEP=<min>   pmset's sleep setting (default 0)
#   FAKE_HOST_RUNNING=<f>   pgrep finds the app while that file exists; osascript's quit removes it
#   FAKE_PLEX_TOKEN=<t>     Plex is signed in (defaults read/export give the token)
#   FAKE_HOST_IMPORTED=<f>  where defaults import copies the settings it's given
#   FAKE_HOST_LOG=<file>    sudo, open, osascript and defaults calls are logged there
#   FAKE_HOST_TS=<file>     one Tailscale container, media-tailscale, whose full status
#                           (tailscale status --json) is that file; FAKE_HOST_TS_ONLINE=false makes
#                           it offline to the coordination server, FAKE_HOST_TS_SERVE=<file> is its
#                           serve status
#   FAKE_HOST_CONTAINERS=<lines>  more containers, as check-health's docker inspect format prints them
#   FAKE_HOST_FWD=<port>|<age>  Gluetun's forwarded port, which it got <age> seconds ago
#   FAKE_HOST_QBIT=<file>   qBittorrent's listening port is in that file (no file: its API doesn't
#                           answer); setPreferences writes it, unless FAKE_HOST_QBIT_STUCK=1
#   FAKE_HOST_RESTART_FAILS=1  docker restart fails (restarts are logged to FAKE_HOST_LOG)
case "$(basename "$0")" in
    docker)
        [ "${FAKE_HOST_DOCKER:-up}" = up ] || exit 1
        case "$1" in
            info) echo 27.5.1 ;;
            restart)
                [ -n "${FAKE_HOST_LOG:-}" ] && echo "docker $*" >>"$FAKE_HOST_LOG"
                [ "${FAKE_HOST_RESTART_FAILS:-0}" = 1 ] && exit 1 ;;
            ps)
                [ "$2" = -aq ] || exit 0
                [ -n "${FAKE_HOST_TS:-}" ] && echo ts1
                [ -n "${FAKE_HOST_CONTAINERS:-}" ] && printf '%s\n' "$FAKE_HOST_CONTAINERS" | awk 'NF { print "c" NR }' ;;
            inspect)
                [ -n "${FAKE_HOST_TS:-}" ] && echo "/media-tailscale|tailscale/tailscale:latest|running||0|false|0|media-tailscale||unless-stopped||"
                [ -n "${FAKE_HOST_CONTAINERS:-}" ] && printf '%s\n' "$FAKE_HOST_CONTAINERS" ;;
            exec)
                case "$*" in
                    *"status --json --peers=false"*)
                        printf '{"BackendState":"Running","Self":{"Online":%s,"DNSName":"kit-media.example.ts.net.","Relay":"nyc"}}\n' "${FAKE_HOST_TS_ONLINE:-true}" ;;  # check-private: allow
                    *"serve status --json"*) cat "${FAKE_HOST_TS_SERVE:-/dev/null}" ;;
                    *kit-hardlink-test*) echo 2 ;;   # Downloads and Movies are one disk
                    *stat*forwarded_port*)
                        [ -n "${FAKE_HOST_FWD:-}" ] || exit 1
                        printf '%s\n' "$(( $(date +%s) - ${FAKE_HOST_FWD#*|} ))" ;;
                    *forwarded_port*)    # like Gluetun's file: no newline after the port
                        [ -n "${FAKE_HOST_FWD:-}" ] || exit 1
                        printf '%s' "${FAKE_HOST_FWD%|*}" ;;
                    *app/setPreferences*)
                        [ -f "${FAKE_HOST_QBIT:-}" ] || exit 1
                        [ "${FAKE_HOST_QBIT_STUCK:-0}" = 1 ] || echo "$*" | sed 's/.*"listen_port":\([0-9]*\).*/\1/' >"$FAKE_HOST_QBIT" ;;
                    *app/preferences*)
                        [ -f "${FAKE_HOST_QBIT:-}" ] || exit 1
                        printf '{"dht":true,"listen_port":%s,"upnp":false}\n' "$(cat "$FAKE_HOST_QBIT")" ;;
                    *"status --json"*) cat "$FAKE_HOST_TS" ;;
                esac ;;
        esac
        exit 0 ;;
    orb) [ "${FAKE_HOST_DOCKER:-up}" = up ] && echo Running || echo Stopped ;;
    sysctl)
        case "$2" in
            kern.boottime) echo "{ sec = $(( $(date +%s) - 86400 * 3 )), usec = 0 } Mon Jan  1 00:00:00 2026" ;;
            hw.ncpu) echo 8 ;;
            vm.loadavg) echo "{ 1.20 1.10 1.00 }" ;;
            vm.swapusage) echo "total = 1024.00M  used = 100.00M  free = 924.00M  (encrypted)" ;;
        esac ;;
    memory_pressure) echo "System-wide memory free percentage: 60%" ;;
    df)
        echo "Filesystem 1024-blocks Used Available Capacity Mounted on"
        case "$*" in
            */Volumes/*)    # a drive (FAKE_HOST_MOUNTS): 20 TB, FAKE_HOST_MEDIA_DISK% used
                u=${FAKE_HOST_MEDIA_DISK:-50}
                echo "/dev/disk5s2 20000000000 $((u * 200000000)) $(((100 - u) * 200000000)) $u% ${!#}" ;;
            *)
                u=${FAKE_HOST_DISK:-40}
                echo "/dev/disk3s5 1000000000 $((u * 10000000)) $(((100 - u) * 10000000)) $u% /System/Volumes/Data" ;;
        esac ;;
    mount)          # FAKE_HOST_MOUNTS: drives mounted under /Volumes (|-separated), or the
                    # FAKE_HOST_MOUNTS_FILE file's lines (for a drive that mounts while a script waits)
        echo '/dev/disk3s5 on /System/Volumes/Data (apfs, local, journaled, nobrowse)'
        { printf '%s\n' "${FAKE_HOST_MOUNTS:-}" | tr '|' '\n'
          [ -n "${FAKE_HOST_MOUNTS_FILE:-}" ] && cat "$FAKE_HOST_MOUNTS_FILE" 2>/dev/null; } | while IFS= read -r v; do
            [ -n "$v" ] && echo "/dev/disk5s2 on $v (hfs, local, nodev, nosuid, journaled, noowners)"
        done ;;
    route) printf '   gateway: %s\n  interface: %s\n' "${FAKE_HOST_GW:-192.168.1.1}" "${FAKE_HOST_IF:-en5}" ;;
    networksetup)
        printf 'Hardware Port: %s\nDevice: %s\nEthernet Address: 00:00:00:00:00:00\n\n' \
            Wi-Fi en0 Ethernet en5 'Thunderbolt Bridge' bridge0 ;;
    ifconfig)
        case " ${FAKE_HOST_UP:-en5} " in
            *" $1 "*) printf '%s: flags=8863<UP>\n\tinet 192.168.1.20 netmask 0xffffff00\n\tstatus: active\n' "$1" ;;
            *) printf '%s: flags=8822<BROADCAST>\n\tstatus: inactive\n' "$1" ;;
        esac ;;
    ping) exit 0 ;;
    dscacheutil) echo "ip_address: 17.253.144.10" ;;
    pmset)
        case "$*" in
            "-g cap") printf 'Capabilities for AC Power:\n displaysleep\n disksleep\n sleep\n womp\n autorestart\n powernap\n' ;;
            "-g") printf ' sleep                %s\n autorestart          1\n disksleep            0\n womp                 1\n powernap             0\n' "${FAKE_HOST_SLEEP:-0}" ;;
            "-g batt")
                if [ "${FAKE_HOST_BATTERY:-0}" = 1 ]; then
                    printf "Now drawing from 'Battery Power'\n -InternalBattery-0 (id=1)\t62%%; discharging\n"
                else
                    echo "Now drawing from 'AC Power'"
                fi ;;
        esac ;;
    hdiutil)        # a .dmg: attaching it puts a fake Jellyfin.app (version FAKE_DMG_VERSION) at the mountpoint
        [ -n "${FAKE_HOST_LOG:-}" ] && printf 'hdiutil %s\n' "$*" >>"$FAKE_HOST_LOG"
        if [ "$1" = attach ]; then
            mp=''
            while [ $# -gt 0 ]; do [ "$1" = -mountpoint ] && mp=$2; shift; done
            [ -n "$mp" ] || exit 1
            mkdir -p "$mp/Jellyfin.app/Contents/MacOS" "$mp/Jellyfin.app/Contents/Resources/jellyfin-web"
            printf '#!/bin/bash\nsleep 1\n' >"$mp/Jellyfin.app/Contents/MacOS/jellyfin"
            chmod +x "$mp/Jellyfin.app/Contents/MacOS/jellyfin"
            printf '%s\n' "${FAKE_DMG_VERSION:-12.4}" >"$mp/Jellyfin.app/Contents/fake-version"
        fi ;;
    launchctl)      # FAKE_HOST_JOBS: more "pid<TAB>status<TAB>label" lines
        printf 'PID\tStatus\tLabel\n-\t0\tio.github.andy327.mac-server-kit.log-health\n'
        [ -z "${FAKE_HOST_JOBS:-}" ] || printf '%b\n' "$FAKE_HOST_JOBS" ;;
    sudo|open) [ -n "${FAKE_HOST_LOG:-}" ] && printf '%s %s\n' "$(basename "$0")" "$*" >>"$FAKE_HOST_LOG" ;;
    osascript)      # quitting an app: it stops running
        [ -n "${FAKE_HOST_LOG:-}" ] && printf 'osascript %s\n' "$*" >>"$FAKE_HOST_LOG"
        case "$*" in *quit*) [ -n "${FAKE_HOST_RUNNING:-}" ] && rm -f "$FAKE_HOST_RUNNING" ;; esac ;;
    pgrep)          # an app runs while the FAKE_HOST_RUNNING file exists (never the Mac's own)
        [ -n "${FAKE_HOST_RUNNING:-}" ] && [ -f "$FAKE_HOST_RUNNING" ] && exit 0
        exit 1 ;;
    defaults)
        [ -n "${FAKE_HOST_LOG:-}" ] && printf 'defaults %s\n' "$*" >>"$FAKE_HOST_LOG"
        case "$1 $2" in
            "read /Library/Preferences/com.apple.loginwindow")    # FAKE_AUTOLOGIN_USER: who logs in by itself
                [ -n "${FAKE_AUTOLOGIN_USER:-}" ] && [ "$3" = autoLoginUser ] && { echo "$FAKE_AUTOLOGIN_USER"; exit 0; }
                exit 1 ;;
            "read com.plexapp.plexmediaserver")
                [ -n "${FAKE_PLEX_TOKEN:-}" ] && [ "$3" = PlexOnlineToken ] && { echo "$FAKE_PLEX_TOKEN"; exit 0; }
                exit 1 ;;
            "read "*/Contents/Info)     # an app's version: its fake-version file (a fake .dmg's), else 1.43.0
                if [ -f "${2%/Info}/fake-version" ]; then cat "${2%/Info}/fake-version"; else echo 1.43.0; fi ;;
            "export com.plexapp.plexmediaserver")
                printf '<plist><dict><key>PlexOnlineToken</key><string>%s</string></dict></plist>\n' "${FAKE_PLEX_TOKEN:-}" >"$3" ;;
            "import "*) cp "$3" "${FAKE_HOST_IMPORTED:-/dev/null}" ;;
        esac ;;
    log)
        case "$*" in
            *configd*)
                echo "2026-11-05 16:52:01.100 Df configd[1]: en5: router ARP failure"
                echo "2026-11-05 16:52:02.200 Df configd[1]: something unrelated" ;;
        esac ;;
    zip) exit 0 ;;
esac
exit 0
