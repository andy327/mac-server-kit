#!/bin/bash
# Run the kit's tests on the dev machine, with stock /bin/bash (3.2) and no dependencies.
# Each test_* function runs in its own subshell with a fresh temporary ~/server.
# Runs shellcheck over the scripts too when it's installed, tests/compose-check when Docker
# Compose is installed, then tests/check-private.
#
# Usage: tests/run [-v] [tests/test-<name>.sh...]
#   -v   list every test with ✓ or ✗ and each file's time; failures show inline
#   KIT_TEST_JOBS=<n>     test files run side by side (default: one per CPU)
#   KIT_TEST_SHARD=<i>/<n>  run only the i-th of n slices of the files (as CI does)

set -u -o pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd -P)"
cd "$ROOT" || exit 1

if [ -t 1 ]; then G=$'\033[32m' R=$'\033[31m' D=$'\033[2m' N=$'\033[0m'; else G='' R='' D='' N=''; fi

verbose=0
case "${1:-}" in -v|--verbose) verbose=1; shift ;; esac
files=${*:-$(ls tests/test-*.sh)}
# KIT_TEST_SHARD=<i>/<n>: with the files from largest to smallest (a rough measure of their run
# time), only every n-th one, starting with the i-th (CI splits the files across runners this way)
if [ -n "${KIT_TEST_SHARD:-}" ]; then
    # shellcheck disable=SC2086,SC2012  # the kit's own test file names
    files=$(ls -S $files | awk -v s="$KIT_TEST_SHARD" 'BEGIN { split(s, a, "/") } (NR - 1) % a[2] == a[1] - 1')
fi
# Files run side by side (each test still in its own subshell and temporary ~/server, so they
# share nothing), at most KIT_TEST_JOBS at once (default: one per CPU). Output stays in file order.
jobs_max=${KIT_TEST_JOBS:-$(sysctl -n hw.ncpu 2>/dev/null || echo 2)}
OUT=$(mktemp -d "${TMPDIR:-/tmp}/kit-run.XXXXXX") || exit 1
trap 'rm -rf "$OUT"' EXIT

now_ms() { perl -MTime::HiRes=time -e 'printf "%d", time * 1000'; }

run_file() {    # file index: writes $OUT/<index>.out (what to print) and .count ("pass failed")
    local file=$1 n=$2 tests start t out rc detail pass=0 failed=0 failures=''
    tests=$(/bin/bash -c ". tests/lib.sh; . '$file'; declare -F" | awk '$3 ~ /^test_/ && $3 != "test_setup" { print $3 }')
    start=$(now_ms)
    {
        [ $verbose = 1 ] && printf '%s\n' "$(basename "$file")"
        for t in $tests; do
            out=$(/bin/bash -c "set -u -o pipefail; . tests/lib.sh; . '$file'; test_setup; $t" 2>&1)
            rc=$?
            detail=$(printf '%s\n' "$out" | tail -n 15 | sed 's/^/    /')
            if [ $rc -eq 0 ]; then
                pass=$((pass + 1))
                if [ $verbose = 1 ]; then printf '  %s✓%s %s\n' "$G" "$N" "$t"; else printf '%s.%s' "$G" "$N"; fi
            else
                failed=$((failed + 1))
                if [ $verbose = 1 ]; then
                    printf '  %s✗%s %s\n%s\n' "$R" "$N" "$t" "$detail"
                else
                    printf '%sF%s' "$R" "$N"
                    failures="$failures
${R}FAIL${N} $file: $t
$detail"
                fi
            fi
        done
        [ $verbose = 1 ] && printf '  %s%s ms%s\n' "$D" "$(( $(now_ms) - start ))" "$N"
    } >"$OUT/$n.out"
    printf '%s' "$failures" >"$OUT/$n.fail"
    echo "$pass $failed" >"$OUT/$n.count"
}

n=0
for file in $files; do
    n=$((n + 1))
    while [ "$(jobs -rp | wc -l)" -ge "$jobs_max" ]; do sleep 0.2; done
    run_file "$file" "$n" &
done
wait

pass=0 failed=0 failures=''
i=0
while [ $i -lt $n ]; do
    i=$((i + 1))
    cat "$OUT/$i.out"
    if [ -f "$OUT/$i.count" ]; then
        read -r p f <"$OUT/$i.count"
        pass=$((pass + p)) failed=$((failed + f))
        failures="$failures$(cat "$OUT/$i.fail")"
    else
        failed=$((failed + 1))      # the file's runner died
        failures="$failures
${R}FAIL${N} file $i didn't finish"
    fi
done
[ $verbose = 1 ] || printf '\n'
[ -n "$failures" ] && printf '%s\n' "$failures"
printf '%s passed, %s failed\n' "$pass" "$failed"

if command -v shellcheck >/dev/null 2>&1; then
    if shellcheck -x kit lib/*.sh tests/run tests/lib.sh tests/test-*.sh tests/check-private tests/compose-check tests/fake-docker tests/fake-curl tests/fake-launchctl modules/*/hooks/* modules/*/bin/*; then
        printf '%sshellcheck clean%s\n' "$G" "$N"
    else
        failed=$((failed + 1))
    fi
else
    printf '%sshellcheck not installed; skipped%s\n' "$D" "$N"
fi

# The generated compose projects, checked by the real docker compose (when it's installed)
if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
    tests/compose-check || failed=$((failed + 1))
else
    printf '%sdocker compose not installed; compose-check skipped (CI runs it)%s\n' "$D" "$N"
fi

# Machine-specific data in the files about to be committed (CI also checks the whole history)
tests/check-private || failed=$((failed + 1))
[ "$failed" -eq 0 ]
