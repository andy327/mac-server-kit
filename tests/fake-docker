#!/bin/bash
# A stand-in for docker in tests (KIT_DOCKER points here; tests/lib.sh sets it for every test).
# Logs each call to $FAKE_DOCKER_LOG (compose calls with the folder they ran in), answers the
# few things the kit asks for, and starts nothing.
#   FAKE_DOCKER_FAIL=<word>   fail calls whose arguments contain <word> (e.g. "pull", "up")
#   FAKE_DOCKER_PS=<lines>    what "compose ps -a --format ..." prints (service|state|health lines)
#   FAKE_TS_TAGS=0            Tailscale nodes joined without a tag
#   FAKE_TS_TAKEN=<node>      that node's name was taken, so Tailscale added "-1"
#   FAKE_DOCKER_RUNNING=<svcs> the services "compose ps --services --status running" lists
#                             (default: sonarr radarr), each with its data in appdata/<svc>
#   FAKE_DOCKER_STUCK=<svcs>  once stopped, these won't start again ("task ... already exists")
#                             until "compose up --force-recreate" makes new containers;
#                             FAKE_DOCKER_STUCK_HARD=1: not even then. What's down is kept in
#                             $FAKE_DOCKER_LOG.down
# Containers, for ./kit install --plan: "compose up" remembers the ones it makes in
# $FAKE_DOCKER_LOG.containers (name|project|service|config-hash|image|running|); "compose down"
# forgets them. "compose config" and "config --hash" read the compose files the way the kit writes
# them (a hash of each service's lines with the .env filled in).
#   FAKE_DOCKER_CONTAINERS=<file>  more containers: name|project|service|hash|image|state|ports|version
#   FAKE_DOCKER_MOUNTS=<file>      their mounts: name|source|destination[|type|volume name]
# Like Compose, a service on another's network (network_mode: "service:X") is hashed with it
# resolved to X's container ("container:id-<X's container name>"), and inspect's {{.Id}} of a
# container is id-<its name>.
#   FAKE_DOCKER_DOWN=1             docker info fails (Docker isn't running)

if [ -n "${FAKE_DOCKER_LOG:-}" ]; then
    if [ "$1" = compose ]; then printf '%s (in %s)\n' "$*" "$PWD"; else printf '%s\n' "$*"; fi >>"$FAKE_DOCKER_LOG"
fi
if [ -n "${FAKE_DOCKER_FAIL:-}" ]; then
    case " $* " in *" $FAKE_DOCKER_FAIL "*) echo "fake-docker: failing on purpose: $*" >&2; exit 1 ;; esac
fi

DOWN=${FAKE_DOCKER_LOG:-/dev/null}.down
is_down() { grep -qx "$1" "$DOWN" 2>/dev/null; }
if [ "$1" = compose ] && [ -n "${FAKE_DOCKER_STUCK:-}" ]; then
    case " $* " in
        *' stop '*)
            for s in $FAKE_DOCKER_STUCK; do
                case " $* " in *" stop "|*" stop "*" $s "*) is_down "$s" || echo "$s" >>"$DOWN" ;; esac
            done ;;
        *' start '*)
            for s in $FAKE_DOCKER_STUCK; do
                case " $* " in *" $s "*) is_down "$s" || continue
                    echo "Error response from daemon: failed to create task for container: AlreadyExists: task id-$s: already exists" >&2
                    exit 1 ;;
                esac
            done ;;
        *' --force-recreate '*)
            if [ "${FAKE_DOCKER_STUCK_HARD:-0}" != 1 ]; then
                for s in $FAKE_DOCKER_STUCK; do
                    case " $* " in *" $s "*) grep -vx "$s" "$DOWN" >"$DOWN.new"; mv "$DOWN.new" "$DOWN" ;; esac
                done
            fi ;;
        *' up '*) [ -s "$DOWN" ] && { echo "fake-docker: a container won't start" >&2; exit 1; } ;;
    esac
fi

STATE=${FAKE_DOCKER_LOG:-/dev/null}.containers

# The compose model as "service<TAB>line" lines, with the .env's values filled in and ./ made the
# project folder's. Files: -f, else COMPOSE_FILE in ./.env; .env: --env-file, else ./.env.
compose_model() {
    local files='' envf=./.env pdir=$PWD a f
    while [ $# -gt 0 ]; do
        case "$1" in
            -f|--file) files="$files
$2"; shift 2 ;;
            --env-file) envf=$2; shift 2 ;;
            --project-directory) pdir=$2; shift 2 ;;
            -p|--project-name) shift 2 ;;
            *) shift ;;
        esac
    done
    if [ -z "$files" ]; then
        for a in $(sed -n "s/^COMPOSE_FILE=//p" "$envf" 2>/dev/null | tr -d "'" | tr ':' ' '); do files="$files
$PWD/$a"; done
    fi
    printf '%s\n' "$files" | while IFS= read -r f; do
        [ -n "$f" ] && [ -f "$f" ] || continue
        awk -v envf="$envf" -v pdir="$pdir" '
            BEGIN { while ((getline l < envf) > 0) { if (l !~ /^[A-Za-z_][A-Za-z0-9_]*=/) continue
                        k = l; sub(/=.*/, "", k); v = l; sub(/^[^=]*=/, "", v); gsub(/^\047|\047$/, "", v); E[k] = v } }
            /^services:/ { s = 1; next }
            /^[^ #]/ { s = 0; next }
            !s { next }
            /^  [a-z0-9][a-z0-9_-]*:[ \t]*$/ { svc = $1; sub(/:$/, "", svc); next }
            svc == "" || /^[ \t]*#/ || /^[ \t]*$/ { next }
            { line = $0
              while (match(line, /\$\{[A-Za-z_][A-Za-z0-9_]*[^}]*\}/)) {
                  ref = substr(line, RSTART + 2, RLENGTH - 3); name = ref; sub(/[^A-Za-z0-9_].*/, "", name)
                  val = (name in E) ? E[name] : ""
                  if (val == "" && ref ~ /:-/) { val = ref; sub(/^[^:]*:-/, "", val) }
                  line = substr(line, 1, RSTART - 1) val substr(line, RSTART + RLENGTH) }
              sub(/ \.\//, " " pdir "/", line); sub(/- \.\//, "- " pdir "/", line)
              print svc "\t" line }' "$f"
    done
}
# Compose refuses a file whose services: is null (a bare services: with nothing under it)
compose_null_services() {   # args -> 0 (and Compose's error) when a -f file has one
    local f
    while [ $# -gt 0 ]; do
        case "$1" in
            -f|--file)
                f=$2; shift 2
                [ -f "$f" ] || continue
                # 0 when the line after a bare services: (blanks and comments aside) isn't indented
                if awk '/^services:[ \t]*$/ { n = 1; next }
                        n && /^[ \t]*(#|$)/ { next }
                        n { exit /^ / }
                        END { if (!n) exit 1 }' "$f"; then
                    echo "services must be a mapping" >&2
                    return 0
                fi ;;
            *) shift ;;
        esac
    done
    return 1
}
compose_project() {     # args -> the project name: -p, else COMPOSE_PROJECT_NAME in the .env
    local envf=./.env p=''
    while [ $# -gt 0 ]; do
        case "$1" in -p|--project-name) p=$2; shift 2 ;; --env-file) envf=$2; shift 2 ;; *) shift ;; esac
    done
    [ -n "$p" ] || p=$(sed -n "s/^COMPOSE_PROJECT_NAME=//p" "$envf" 2>/dev/null | tr -d "'")
    printf '%s' "$p"
}
compose_hashes() {      # model on stdin -> "service hash" lines, in order
    awk -F'\t' '{ if (!($1 in seen)) { o[++n] = $1; seen[$1] = 1 }
                   if ($2 ~ /^    network_mode:/) nm[$1] = $2 "\n"; else b[$1] = b[$1] $2 "\n" }
        END { for (i = 1; i <= n; i++) { printf "%s ", o[i]; printf "%s", b[o[i]] nm[o[i]] | "shasum -a 256 | cut -c1-64"; close("shasum -a 256 | cut -c1-64") } }'
}
resolve_net() {         # model on stdin -> the same, network_mode "service:X" as Compose runs it
    local m
    m=$(cat)
    printf '%s\n' "$m" | awk -F'\t' '
        NR == FNR { if ($2 ~ /^    container_name:/) { v = $2; sub(/^    container_name: */, "", v); cn[$1] = v }; next }
        $2 ~ /^    network_mode: *"?service:/ { x = $2; sub(/.*service:/, "", x); gsub(/"/, "", x)
            print $1 "\t    network_mode: \"container:id-" (x in cn ? cn[x] : x) "\""; next }
        { print }' - <(printf '%s\n' "$m")
}
compose_config() {      # model on stdin -> the parts of docker compose config's output the kit reads
    awk -F'\t' '
        { if (!($1 in seen)) { o[++n] = $1; seen[$1] = 1 } L[$1, ++c[$1]] = $2 }
        END {
            print "services:"
            for (i = 1; i <= n; i++) {
                s = o[i]; print "  " s ":"; vol = ""; prt = ""; sect = ""; src = ""
                for (j = 1; j <= c[s]; j++) {
                    l = L[s, j]
                    if (l ~ /^    [a-z_]+:/) { sect = l; sub(/^    /, "", sect); sub(/:.*/, "", sect)
                        if (sect == "container_name") { v = l; sub(/^    container_name: */, "", v); print "    container_name: " v }
                        if (sect == "network_mode") print l }
                    else if (sect == "volumes" && l ~ /^      - [^ ]*:/ && l !~ /type:/) {
                        v = l; sub(/^      - /, "", v); gsub(/"/, "", v); k = split(v, a, ":")
                        vol = vol "      - type: " (a[1] ~ /^[\/~.]/ ? "bind" : "volume") "\n        source: " a[1] "\n        target: " a[2] "\n" }
                    else if (sect == "volumes" && l ~ /^        source: /) { src = l; sub(/^        source: */, "", src) }
                    else if (sect == "volumes" && l ~ /^        target: /) { t = l; sub(/^        target: */, "", t)
                        vol = vol "      - type: bind\n        source: " src "\n        target: " t "\n" }
                    else if (sect == "ports" && l ~ /^      - /) { v = l; sub(/^      - /, "", v); gsub(/"/, "", v); k = split(v, a, ":")
                        prt = prt "      - mode: ingress\n        published: \"" (k == 3 ? a[2] : a[1]) "\"\n" }
                }
                if (vol != "") printf "    volumes:\n%s", vol
                if (prt != "") printf "    ports:\n%s", prt
            }
        }'
}
state_up() {            # project model-file remove-orphans
    local p=$1 model=$2 tmp names
    tmp=$STATE.new
    # shellcheck disable=SC2094  # reads the model only
    names=$(resolve_net <"$model" | compose_hashes | while read -r svc hash; do
        cn=$(awk -F'\t' -v s="$svc" '$1 == s && $2 ~ /^    container_name:/ { v = $2; sub(/^    container_name: */, "", v); n = v } END { print n }' "$model")
        img=$(awk -F'\t' -v s="$svc" '$1 == s && $2 ~ /^    image:/ { v = $2; sub(/^    image: */, "", v); n = v } END { print n }' "$model")
        printf '%s|%s|%s|%s|%s|running|\n' "${cn:-$p-$svc-1}" "$p" "$svc" "$hash" "$img"
    done)
    { [ -f "$STATE" ] && printf '%s\n' "$names" | awk -F'|' -v p="$p" -v ro="$3" '
          NR == FNR { keep[$1] = 1; svc[$3] = 1; next }
          !($1 in keep) && !(ro == 1 && $2 == p) { print }' - "$STATE"
      printf '%s\n' "$names"; } | sed '/^$/d' >"$tmp"
    mv "$tmp" "$STATE"
}
all_containers() { cat "$STATE" "${FAKE_DOCKER_CONTAINERS:-/dev/null}" 2>/dev/null; }

case "$1" in
    image)
        # image inspect --format ... <ref>: a made-up digest that depends on the ref and on
        # FAKE_DOCKER_SALT (to make "a newer image" in a test)
        ref=${*: -1}
        sum=$(printf '%s%s' "$ref" "${FAKE_DOCKER_SALT:-}" | shasum -a 256 | cut -c1-64)
        printf '%s@sha256:%s\n' "${ref%:*}" "$sum" ;;
    context) exit 1 ;;
    exec)
        # exec romm-db sh -c ...: RomM's views whose definer this database lacks
        # (FAKE_ROMM_ORPHANS, until the kit makes them again; FAKE_ROMM_VIEWS_FAIL=1 refuses that)
        if [ "$2" = romm-db ]; then
            case "$*" in
                *'not exists'*)
                    # shellcheck disable=SC2086  # one view per word
                    [ -f "$STATE.romm-views" ] || printf '%s\n' ${FAKE_ROMM_ORPHANS:-} ;;
                *'CREATE OR REPLACE'*)
                    [ "${FAKE_ROMM_VIEWS_FAIL:-0}" = 1 ] && { echo "ERROR 1142 (42000): CREATE VIEW command denied" >&2; exit 1; }
                    : >"$STATE.romm-views" ;;
            esac
            exit 0
        fi
        # exec <node>-tailscale tailscale status --json ...: a logged-in node in tailnet tail0000
        node=${2%-tailscale}
        name=$node
        [ "${FAKE_TS_TAKEN:-}" = "$node" ] && name=$node-1
        tags='"Tags":["tag:server"],'
        tn=tail0000.ts.net  # check-private: allow
        # untagged: a login that expires, unless FAKE_TS_EXPIRY=0 (expiry turned off)
        if [ "${FAKE_TS_TAGS:-1}" = 0 ]; then
            tags=''
            [ "${FAKE_TS_EXPIRY:-1}" = 0 ] || tags='"KeyExpiry":"2027-05-11T09:30:00Z",'
        fi
        printf '{\n  "BackendState": "Running",\n  "Self": {\n    "ID": "n1",\n    "HostName": "%s",\n    "DNSName": "%s.%s.",\n    %s"Online": true\n  },\n  "CurrentTailnet": { "Name": "example", "MagicDNSSuffix": "%s", "MagicDNSEnabled": true },\n  "CertDomains": ["%s.%s"]\n}\n' \
            "$name" "$name" "$tn" "$tags" "$tn" "$name" "$tn" ;;
    info) [ "${FAKE_DOCKER_DOWN:-0}" = 1 ] && exit 1; echo 27.5.1 ;;
    ps)
        # ps -a --format name|project|service|hash|image|state|ports
        all_containers | cut -d'|' -f1-7 ;;
    inspect)
        id=${*: -1}
        row=$(all_containers | awk -F'|' -v n="$id" '$1 == n { print; exit }')
        if [ -n "$row" ]; then
            case "$*" in
                *Mounts*) awk -F'|' -v n="$id" '$1 == n { print ($4 == "" ? "bind" : $4) "|" $5 "|" $2 "|" $3 }' "${FAKE_DOCKER_MOUNTS:-/dev/null}" ;;
                *'{{.Id}}'*) printf 'id-%s\n' "$id" ;;
                *image.version*) printf '%s\n' "$row" | cut -d'|' -f8 ;;
                *'{{.Image}}'*) printf '%s\n' "$row" | cut -d'|' -f5 ;;
            esac
            exit 0
        fi
        # inspect --format <mounts> <id>: the container id-<svc> keeps its data in the media
        # stack's app data folder, <svc>/
        id=${*: -1}
        printf '%s/appdata/media-stack/%s\n' "${KIT_SERVER_DIR:-}" "${id#id-}" ;;
    compose)
        case "$*" in *' config'*) ! compose_null_services "$@" || exit 1 ;; esac
        case "$*" in
            *' config --services'*) for x in ${FAKE_DOCKER_RUNNING-sonarr radarr}; do echo "$x"; done ;;
            *' config --hash'*) compose_model "$@" | compose_hashes ;;
            *' config'|*' config '*) [ "${*: -1}" = config ] && compose_model "$@" | compose_config ;;
            *' up '*|*' up')
                m=$(mktemp "${TMPDIR:-/tmp}/fake-model.XXXXXX")
                compose_model "$@" >"$m"
                ro=0; case " $* " in *' --remove-orphans '*) ro=1 ;; esac
                [ -n "${FAKE_DOCKER_LOG:-}" ] && state_up "$(compose_project "$@")" "$m" "$ro"
                rm -f "$m" ;;
            *' down'*)
                p=$(compose_project "$@")
                [ -f "$STATE" ] && awk -F'|' -v p="$p" '$2 != p' "$STATE" >"$STATE.new" && mv "$STATE.new" "$STATE" ;;
            *' version'*) echo '2.31.0' ;;
            *' ps --services --status running'*)
                for x in ${FAKE_DOCKER_RUNNING-sonarr radarr}; do is_down "$x" || echo "$x"; done ;;
            *' ps -q '*) printf 'id-%s\n' "${*: -1}" ;;
            *' ps -a --format'*) [ -z "${FAKE_DOCKER_PS:-}" ] || printf '%s\n' "$FAKE_DOCKER_PS" ;;
        esac ;;
esac
exit 0
