#!/bin/bash
# A stand-in for docker in tests (KIT_DOCKER points here; tests/lib.sh sets it for every test).
# Logs each call to $FAKE_DOCKER_LOG, answers the few things the kit asks for, starts nothing.
#   FAKE_DOCKER_FAIL=<word>   fail calls whose arguments contain <word> (e.g. "pull", "up")

[ -n "${FAKE_DOCKER_LOG:-}" ] && printf '%s\n' "$*" >>"$FAKE_DOCKER_LOG"
if [ -n "${FAKE_DOCKER_FAIL:-}" ]; then
    case " $* " in *" $FAKE_DOCKER_FAIL "*) echo "fake-docker: failing on purpose: $*" >&2; exit 1 ;; esac
fi

case "$1" in
    image)
        # image inspect --format ... <ref>: a made-up digest that depends on the ref and on
        # FAKE_DOCKER_SALT (to make "a newer image" in a test)
        ref=${*: -1}
        sum=$(printf '%s%s' "$ref" "${FAKE_DOCKER_SALT:-}" | shasum -a 256 | cut -c1-64)
        printf '%s@sha256:%s\n' "${ref%:*}" "$sum" ;;
    context) exit 1 ;;
    compose)
        case "$*" in *' version'*) echo '2.31.0' ;; esac ;;
esac
exit 0
