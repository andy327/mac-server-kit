#!/bin/bash
# A stand-in for curl in tests (KIT_CURL points here; tests/lib.sh sets it for every test).
# Plays the apps' list APIs from files under $FAKE_CURL_DIR: GET a URL returns its list, POST adds
# the body to it (with an id) and answers 201. Each call is logged to $FAKE_CURL_LOG as
# "METHOD host:port/path". Never touches the network.
#   FAKE_CURL_FAIL=<text>    calls whose URL contains <text> answer 500 with an error message
#   FAKE_CURL_DOWN=<text>    calls whose URL contains <text> get no answer (curl exit 7)
#   FAKE_CURL_FLAKY=<text>   the first call whose URL contains <text> times out; later ones answer
#   FAKE_SEERR_INIT=1        Seerr reports that someone has signed in
#   FAKE_PLEX_LIBRARIES=<t..> the kinds of library Plex has (default: movie show; "none" for none)
#   FAKE_REGISTRY_TAGS=<t..> the tags an image registry lists (default: some Homarr releases)
# Homarr (port 7575) has its own small state: its setup step, the keys it made, its sign-in.
#   FAKE_HOMARR_SET_UP=1     Homarr's setup was done by hand already (an account exists)
#   FAKE_HOMARR_KEY=<key>    a key Homarr accepts besides the ones it made
#   FAKE_HOMARR_OLD=1        Homarr has no custom widgets yet
#   FAKE_HOMARR_EDITED=<name> that custom widget was changed in Homarr after the kit put it in

method=GET data='' url='' fmt='' key='' out='' auth=''
while [ $# -gt 0 ]; do
    case "$1" in
        -X) method=$2; shift 2 ;;
        --data|-d|--data-raw) data=$2; [ "$method" = GET ] && method=POST; shift 2 ;;
        --data-urlencode) data="${data:+$data&}$2"; method=POST; shift 2 ;;
        -w) fmt=$2; shift 2 ;;
        -H) case "$2" in ApiKey:*|X-Api-Key:*) key=${2#*: } ;; Authorization:*) auth=${2#*: } ;; esac; shift 2 ;;
        -o) out=$2; shift 2 ;;
        --max-time|-m|--retry|-b|-c) shift 2 ;;
        -*) shift ;;
        *) url=$1; shift ;;
    esac
done
path=/${url#*://*/}
[ -n "${FAKE_CURL_LOG:-}" ] && printf '%s %s\n' "$method" "${url#*://}" >>"$FAKE_CURL_LOG"

answer() {          # status body
    if [ -n "$out" ] && [ "$out" != /dev/null ] && [ "$out" != - ]; then printf '%s' "$2" >"$out"
    elif [ "$out" != /dev/null ]; then printf '%s' "$2"; fi
    case "$fmt" in *http_code*) if [ "$out" = /dev/null ]; then printf '%s' "$1"; else printf '\n%s' "$1"; fi ;; esac
    exit 0
}

# Native app downloads: Plex's download list and its zip (a real zip of an empty app, whose
# SHA-1 the list gives), and uv's installer (a script that makes a fake uv, which makes a fake
# glances). FAKE_PLEX_BAD_SUM=1 makes the list's checksum wrong.
dir=${FAKE_CURL_DIR:?set FAKE_CURL_DIR}
mkdir -p "$dir"
case "$url" in
    https://plex.tv/api/downloads/5.json)
        z=$dir/plex.zip
        if [ ! -f "$z" ]; then
            mkdir -p "$dir/plexzip/Plex Media Server.app/Contents/MacOS" && touch "$dir/plexzip/Plex Media Server.app/Contents/MacOS/Plex Media Server"
            (cd "$dir/plexzip" && ditto -c -k --keepParent "Plex Media Server.app" "$z")
        fi
        sum=$(shasum -a 1 "$z" | cut -d' ' -f1)
        [ "${FAKE_PLEX_BAD_SUM:-0}" = 1 ] && sum=0000000000000000000000000000000000000000
        printf '{"computer":{"MacOS":{"id":"macos","version":"1.43.0","releases":[{"label":"Download","build":"darwin-x86_64","distro":"macos","url":"https://downloads.plex.tv/plex-media-server-new/1.43.0/macos/PlexMediaServer-1.43.0-universal.zip","checksum":"%s"}]}}}' "$sum"
        exit 0 ;;
    https://downloads.plex.tv/*.zip) cp "$dir/plex.zip" "$out"; exit 0 ;;
    # Homebrew's cask data for Jellyfin (version FAKE_JELLYFIN_RELEASE, default 12.4) and its
    # .dmgs, whose SHA-256 it gives (FAKE_JELLYFIN_BAD_SUM=1 makes it wrong)
    https://formulae.brew.sh/api/cask/jellyfin.json)
        v=${FAKE_JELLYFIN_RELEASE:-12.4}
        printf 'fake jellyfin %s dmg' "$v" >"$dir/jellyfin.dmg"
        sum=$(shasum -a 256 "$dir/jellyfin.dmg" | cut -d' ' -f1)
        [ "${FAKE_JELLYFIN_BAD_SUM:-0}" = 1 ] && sum=$(printf '%064d' 0)
        r=https://repo.jellyfin.org/files/server/macos/stable/v$v
        printf '{\n  "token": "jellyfin",\n  "version": "%s",\n  "url": "%s/arm64/jellyfin_%s-arm64.dmg",\n  "sha256": "%s",\n  "variations": {\n    "sequoia": {\n      "url": "%s/amd64/jellyfin_%s-amd64.dmg",\n      "sha256": "%s"\n    }\n  }\n}\n' \
            "$v" "$r" "$v" "$sum" "$r" "$v" "$sum"
        exit 0 ;;
    https://repo.jellyfin.org/*.dmg) printf 'fake jellyfin %s dmg' "${FAKE_JELLYFIN_RELEASE:-12.4}" >"$out"; exit 0 ;;
    https://astral.sh/uv/install.sh)
        cat <<'UV'
mkdir -p "$HOME/.local/bin"
cat >"$HOME/.local/bin/uv" <<'X'
#!/bin/bash
[ "$1 $2" = "tool install" ] || exit 0
printf '#!/bin/bash
echo "Glances version:	4.0.0"
' >"$HOME/.local/bin/glances" && chmod +x "$HOME/.local/bin/glances"
X
chmod +x "$HOME/.local/bin/uv"
UV
        exit 0 ;;
esac

# The first call to a URL containing FAKE_CURL_FLAKY times out (curl exit 28); later ones answer
if [ -n "${FAKE_CURL_FLAKY:-}" ] && [[ $url == *"$FAKE_CURL_FLAKY"* ]] && [ ! -f "$FAKE_CURL_DIR/flaky-done" ]; then
    mkdir -p "$FAKE_CURL_DIR" && touch "$FAKE_CURL_DIR/flaky-done"
    printf '000'
    exit 28
fi
if [ -n "${FAKE_CURL_DOWN:-}" ] && [[ $url == *"$FAKE_CURL_DOWN"* ]]; then
    echo "curl: (7) Failed to connect" >&2
    exit 7
fi
if [ -n "${FAKE_CURL_FAIL:-}" ] && [[ $url == *"$FAKE_CURL_FAIL"* ]]; then
    answer 500 '[{"propertyName":"x","errorMessage":"Failed on purpose"}]'
fi

# Image registries: a pull token, and a repo's tags (FAKE_REGISTRY_TAGS, space-separated)
case "$url" in
    https://ghcr.io/token*|https://auth.docker.io/token*) answer 200 '{"token":"fake-token"}' ;;
    https://*/v2/*/tags/list*)
        tags=${FAKE_REGISTRY_TAGS:-latest v2.9.3 v2.10.0 v2.11.1 v3.0.0-beta.1 v2.11.1-alpine}
        answer 200 "{\"name\":\"x\",\"tags\":[\"$(printf '%s' "$tags" | sed 's/ /","/g')\"]}" ;;
esac

case "$path" in
    /library/sections)
        libs=''
        for t in ${FAKE_PLEX_LIBRARIES:-movie show}; do
            [ "$t" = none ] || libs="$libs<Directory key=\"x\" type=\"$t\" title=\"$t\"/>"
        done
        answer 200 "<?xml version=\"1.0\" encoding=\"UTF-8\"?><MediaContainer>$libs</MediaContainer>" ;;
    /api/v1/settings/public)
        if [ "${FAKE_SEERR_INIT:-0}" = 1 ]; then answer 200 '{"initialized":true}'; fi
        answer 200 '{"initialized":false}' ;;
    /api/v1/settings/*/test)
        # Shaped like Sonarr's quality profiles: qualities with their own id and name come first
        answer 200 '{"profiles":[{"name":"Any","upgradeAllowed":false,"cutoff":1,"items":[{"quality":{"id":0,"name":"Unknown","source":"unknown"},"items":[],"allowed":false},{"quality":{"id":1,"name":"SDTV"},"items":[],"allowed":true}],"formatItems":[],"id":4},{"name":"HD-1080p","items":[],"id":6}],"rootFolders":[{"id":1,"path":"/tv"}]}' ;;
    /api/v1/settings/sonarr|/api/v1/settings/radarr)
        # Seerr's API checks its schema's required properties (seerr-api.yml)
        if [ "$method" = POST ]; then
            req="name hostname port apiKey useSsl activeProfileId activeProfileName activeDirectory is4k isDefault"
            case "$path" in *sonarr) req="$req enableSeasonFolders" ;; *) req="$req minimumAvailability" ;; esac
            for r in $req; do
                case "$data" in *"\"$r\":"*) ;; *) answer 400 "{\"message\":\"request/body must have required property '$r'\",\"errors\":[]}" ;; esac
            done
        fi ;;
esac

dir=${FAKE_CURL_DIR:?set FAKE_CURL_DIR}
mkdir -p "$dir"

trpc() { answer 200 "{\"result\":{\"data\":{\"json\":$1}}}"; }
case "$url" in *:7575/*)
    hstep=$dir/homarr-step
    [ -f "$hstep" ] || { if [ "${FAKE_HOMARR_SET_UP:-0}" = 1 ]; then echo finish; else echo start; fi >"$hstep"; }
    keyok() { [ -n "$key" ] && { [ "$key" = "${FAKE_HOMARR_KEY:-}" ] || grep -qxF "$key" "$dir/homarr-keys" 2>/dev/null; }; }
    case "$method $path" in
        "GET /api/trpc/onboard.currentStep") trpc "{\"current\":\"$(cat "$hstep")\",\"previous\":null}" ;;
        "POST /api/onboarding/claim") answer 200 '' ;;
        "POST /api/trpc/onboard.nextStep") [ "$(cat "$hstep")" = start ] && echo user >"$hstep"; trpc null ;;
        "POST /api/trpc/user.initUser")
            [ "$(cat "$hstep")" = user ] || answer 403 '{"error":{"json":{"message":"Wrong step"}}}'
            echo setup >"$hstep"; trpc null ;;
        "GET /api/auth/csrf") answer 200 '{"csrfToken":"fake-csrf"}' ;;
        "POST /api/auth/callback/credentials") touch "$dir/homarr-session"; answer 302 '' ;;
        "GET /api/auth/session") [ -f "$dir/homarr-session" ] && answer 200 '{"user":{"name":"admin"}}'; answer 200 'null' ;;
        "POST /api/trpc/apiKeys.create")
            [ -f "$dir/homarr-session" ] || answer 401 '{"error":{"json":{"message":"UNAUTHORIZED"}}}'
            k="fake$(( $(wc -l <"$dir/homarr-keys" 2>/dev/null || echo 0) + 1 )).0123456789abcdef0123456789abcdef"
            echo "$k" >>"$dir/homarr-keys"
            trpc "{\"apiKey\":\"$k\"}" ;;
    esac
    keyok || answer 401 '{"message":"UNAUTHORIZED","code":"UNAUTHORIZED"}'
    case "$method $path" in
        "GET /api/info") answer 200 '{"version":"2.3.0"}' ;;
        "GET /api/apps") [ -f "$dir/homarr-apps" ] && answer 200 "[$(paste -sd, "$dir/homarr-apps")]"; answer 200 '[]' ;;
        "POST /api/apps")
            n=$(( $(wc -l <"$dir/homarr-apps" 2>/dev/null || echo 0) + 1 ))
            obj="{\"id\":\"app$n\",${data#\{}"
            echo "$obj" >>"$dir/homarr-apps"
            answer 200 "{\"appId\":\"app$n\",${obj#\{}" ;;
        "GET /api/trpc/integration.all") [ -f "$dir/homarr-integrations" ] && trpc "[$(paste -sd, "$dir/homarr-integrations")]"; trpc '[]' ;;
        "POST /api/trpc/integration.create")
            obj=${data#\{\"json\":}; obj=${obj%\}}
            if [ -n "${FAKE_CURL_FAIL:-}" ] && [[ $obj == *"$FAKE_CURL_FAIL"* ]]; then
                trpc '{"error":{"type":"request","name":"s","message":"Unable to connect to the integration"}}'
            fi
            echo "$obj" >>"$dir/homarr-integrations"
            trpc "{\"integration\":$obj}" ;;
        "GET /api/trpc/customWidget.list")
            [ "${FAKE_HOMARR_OLD:-0}" = 1 ] && answer 404 '{"error":{"json":{"message":"No procedure found on path \"customWidget.list\""}}}'
            [ -f "$dir/homarr-widgets" ] || trpc '[]'
            trpc "[$(sed "/\"name\":\"${FAKE_HOMARR_EDITED:-}\"/s/\"updatedAt\":\"[^\"]*\"/\"updatedAt\":\"2026-02-02T00:00:00.000Z\"/" "$dir/homarr-widgets" | paste -sd, -)]" ;;
        "GET /api/trpc/customWidget.export"*)
            # The template the widget was last given ($dir/homarr-widget-<id>.json holds its body)
            id=$(printf '%s' "$url" | sed -n 's/.*%22id%22%3A%22\([^%]*\)%22.*/\1/p')
            [ -f "$dir/homarr-widget-$id.json" ] || answer 404 '{"error":{"json":{"message":"Not found"}}}'
            trpc "$(cat "$dir/homarr-widget-$id.json")" ;;
        "POST /api/trpc/customWidget.import"|"POST /api/trpc/customWidget.update")
            # Homarr parses the body as JSON; so does plutil (stock macOS)
            if command -v plutil >/dev/null && ! printf '%s' "$data" | plutil -convert xml1 -o /dev/null - 2>/dev/null; then
                answer 400 '{"error":{"json":{"message":"Unexpected non-whitespace character after JSON"}}}'
            fi
            # Keep the name and updatedAt, the way the list shows them, and the body for an export.
            # Homarr's updatedAt counts calls here; FAKE_HOMARR_EDITED=<name> bumps one, as if
            # someone changed it in Homarr.
            name=$(printf '%s' "$data" | grep -o '"name":"[^"]*"' | head -n 1)
            if [ "${path#*customWidget.}" = import ]; then
                id=w$(( $(wc -l <"$dir/homarr-widgets" 2>/dev/null || echo 0) + 1 ))
                printf '%s\n' "$data" >>"$dir/homarr-widget-imports"
            else
                id=$(printf '%s' "$data" | sed -n 's/^{"json":{"id":"\([^"]*\)".*/\1/p')
                grep -q "\"id\":\"$id\"" "$dir/homarr-widgets" 2>/dev/null || answer 404 '{"error":{"json":{"message":"NOT_FOUND"}}}'
                printf '%s\n' "$data" >>"$dir/homarr-widget-updates"
            fi
            n=$(( $(cat "$dir/homarr-clock" 2>/dev/null || echo 0) + 1 )); echo "$n" >"$dir/homarr-clock"
            { grep -v "\"id\":\"$id\"" "$dir/homarr-widgets" 2>/dev/null
              printf '{"id":"%s","managementPath":"/manage/custom-widgets/edit/%s",%s,"updatedAt":"2026-01-01T00:00:%02d.000Z","enabled":true}\n' "$id" "$id" "$name" "$n"
            } >"$dir/homarr-widgets.new" && mv "$dir/homarr-widgets.new" "$dir/homarr-widgets"
            printf '%s' "$data" | sed 's/^{"json":{"widget":\(.*\)}}$/\1/; s/^{"json":{"id":"[^"]*",\(.*\)}$/{\1/' >"$dir/homarr-widget-$id.json"
            trpc "{\"id\":\"$id\"}" ;;
    esac
    answer 404 '{"error":"not handled by fake-curl"}' ;;
esac
# Jellyfin (port 8096): its first-run steps, sign-in, API keys and libraries, in files under
# $FAKE_CURL_DIR. FAKE_JELLYFIN_SET_UP=1: someone finished its setup by hand already.
case "$url" in *:8096/*)
    jpath=${path%%\?*} query=''
    case "$path" in *\?*) query=${path#*\?} ;; esac
    token=$(printf '%s' "$auth" | sed -n 's/.*Token="\([^"]*\)".*/\1/p')
    done_file=$dir/jf-done
    [ "${FAKE_JELLYFIN_SET_UP:-0}" = 1 ] && touch "$done_file"
    qarg() { printf '%s' "$query" | tr '&' '\n' | sed -n "s/^$1=//p" | sed 's/%20/ /g; s/%26/\&/g; s/%2B/+/g; s/%23/#/g; s/%25/%/g'; }
    case "$method $jpath" in
        "GET /health") answer 200 Healthy ;;
        "GET /System/Info/Public")
            if [ -f "$done_file" ]; then answer 200 '{"Version":"12.4","StartupWizardCompleted":true}'; fi
            answer 200 '{"Version":"12.4","StartupWizardCompleted":false}' ;;
        */Startup/*)
            [ -f "$done_file" ] && answer 401 ''
            printf '%s %s\n' "$method" "$jpath" >>"$dir/jf-startup"
            case "$method $jpath" in
                "GET /Startup/User") answer 200 '{"Name":"MyJellyfinUser","Password":""}' ;;
                "POST /Startup/User") printf '%s' "$data" | sed -n 's/.*"Password":"\([^"]*\)".*/\1/p' >"$dir/jf-pw" ;;
                "POST /Startup/Complete")    # and its config says so, as the real one's does
                    touch "$done_file"
                    mkdir -p "$HOME/Library/Application Support/jellyfin/config"
                    echo '<IsStartupWizardCompleted>true</IsStartupWizardCompleted>' >"$HOME/Library/Application Support/jellyfin/config/system.xml" ;;
            esac
            answer 204 '' ;;
        "POST /Users/AuthenticateByName")  # check-private: allow
            pw=$(printf '%s' "$data" | sed -n 's/.*"Pw":"\([^"]*\)".*/\1/p')
            [ -f "$dir/jf-pw" ] && [ "$pw" = "$(cat "$dir/jf-pw")" ] || answer 401 'Error processing request.'
            answer 200 '{"User":{"Id":"u1","Name":"admin"},"AccessToken":"session-token"}' ;;
    esac
    { [ "$token" = session-token ] || [ "$token" = "${FAKE_JELLYFIN_KEY:-none}" ] ||
        { [ -n "$token" ] && grep -q "^$token|" "$dir/jf-keys" 2>/dev/null; }; } || answer 401 ''
    case "$method $jpath" in
        "GET /System/Info") answer 200 '{"Version":"12.4","Id":"x"}' ;;
        "POST /Sessions/Logout") answer 204 '' ;;
        "POST /Auth/Keys")
            n=$(( $(wc -l <"$dir/jf-keys" 2>/dev/null || echo 0) + 1 ))
            printf 'jfkey%s0123456789abcdef|%s\n' "$n" "$(qarg app)" >>"$dir/jf-keys"
            answer 204 '' ;;
        "GET /Auth/Keys")
            items=$(awk -F'|' '{ printf "%s{\"AccessToken\":\"%s\",\"AppName\":\"%s\"}", (NR > 1 ? "," : ""), $1, $2 }' "$dir/jf-keys" 2>/dev/null)
            answer 200 "{\"Items\":[$items],\"TotalRecordCount\":0}" ;;
        "GET /Library/VirtualFolders")
            answer 200 "[$(paste -sd, "$dir/jf-libs" 2>/dev/null)]" ;;
        "POST /Library/VirtualFolders")
            printf '{"Name":"%s","Locations":["%s"],"CollectionType":"%s"}\n' "$(qarg name)" "$(qarg paths)" "$(qarg collectionType)" >>"$dir/jf-libs"
            answer 204 '' ;;
    esac
    answer 404 '' ;;
esac

# Sonarr/Radarr/Prowlarr host settings: one object; a PUT with a login keeps it (the user is made
# only when the password and its confirmation match, as theirs check)
case "$path" in */config/host|*/config/host/*)
    hstore=$dir/$(printf '%s' "${url#*://}" | sed 's|/config/host.*|/config/host|' | tr '/:' '__')
    case "$method" in
        GET)
            [ -f "$hstore" ] && answer 200 "$(cat "$hstore")"
            answer 200 '{"bindAddress":"*","port":8989,"authenticationMethod":"none","authenticationRequired":"enabled","username":"","password":"","passwordConfirmation":"","apiKey":"k","id":1}' ;;
        PUT)
            pw=$(printf '%s' "$data" | sed -n 's/.*"password":"\([^"]*\)".*/\1/p')
            pc=$(printf '%s' "$data" | sed -n 's/.*"passwordConfirmation":"\([^"]*\)".*/\1/p')
            [ -n "$pw" ] && [ "$pw" = "$pc" ] || answer 400 '[{"propertyName":"PasswordConfirmation","errorMessage":"Must match Password"}]'
            printf '%s' "$data" | sed 's/"passwordConfirmation":"[^"]*"/"passwordConfirmation":""/' >"$hstore"
            answer 202 "$data" ;;
    esac ;;
esac
store=$dir/$(printf '%s' "${url#*://}" | tr '/:' '__')   # per app (port) and path
case "$method" in
    GET)
        if [ -f "$store" ]; then answer 200 "[$(paste -sd, "$store")]"; fi
        answer 200 '[]' ;;
    POST)
        n=$(( $( (cat "$store" 2>/dev/null || true) | wc -l) + 1 ))
        obj="{\"id\":$n,${data#\{}"
        printf '%s\n' "$obj" >>"$store"
        answer 201 "$obj" ;;
esac
answer 405 '{"error":"not handled by fake-curl"}'
