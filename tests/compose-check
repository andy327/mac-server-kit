#!/bin/bash
# Generate each compose project the way ./kit install does, then have the real `docker compose
# config` check it: YAML, variables, file merging. Starts nothing and needs no Docker engine, just
# the docker CLI with Compose. CI runs it on Linux; tests/run runs it when Compose is installed.
#
# Usage: tests/compose-check

set -u -o pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd -P)"
cd "$ROOT" || exit 1
. tests/lib.sh

if [ -t 1 ]; then G=$'\033[32m' R=$'\033[31m' N=$'\033[0m'; else G='' R='' N=''; fi

if ! command -v docker >/dev/null 2>&1 || ! docker compose version >/dev/null 2>&1; then
    printf 'compose-check: docker compose is not installed\n' >&2
    exit 2
fi

# test_setup gives each run a temporary HOME; Docker still needs the real one for its plugins
export DOCKER_CONFIG=${DOCKER_CONFIG:-$HOME/.docker}

bad=0
check() {           # label answers-lines...: generate with these answers, then compose config
    local label=$1 out p
    shift
    (
        test_setup
        printf '%s\n' "WIREGUARD_PRIVATE_KEY=\"$FAKE_WG\"" "TS_AUTHKEY=\"$FAKE_TSKEY\"" >"$TEST_TMP/s.conf"
        printf '%s\n' "$@" >"$TEST_TMP/a.conf"
        out=$(kit install --answers "$TEST_TMP/a.conf" --secrets "$TEST_TMP/s.conf" 2>&1) \
            || { printf '%s\n' "$out"; exit 1; }
        # A user override, as Compose merges it
        printf 'services:\n  sonarr:\n    environment:\n      - EXAMPLE=1\n' \
            >"$KIT_SERVER_DIR/media-stack/compose.override.yml"
        kit install >/dev/null 2>&1 || exit 1
        for p in "$KIT_SERVER_DIR"/*/.env; do
            (cd "$(dirname "$p")" && docker compose config -q) || exit 1
            grep -q 'compose.override.yml' "$p" || { echo "override not listed in $p"; exit 1; }
            # ./ in the compose files means the project folder, not compose.d/
            if grep -q 'compose.d/' <<<"$(cd "$(dirname "$p")" && docker compose config | grep 'source:')"; then
                echo "a bind mount points into compose.d/ in $(dirname "$p")"; exit 1
            fi
        done
    ) && { printf '  %s✓%s %s\n' "$G" "$N" "$label"; return 0; }
    printf '  %s✗%s %s\n' "$R" "$N" "$label"
    bad=1
}

printf 'docker compose config (%s)\n' "$(docker compose version --short)"
check 'ProtonVPN, Plex' 'TIMEZONE=America/New_York' 'VPN_PROVIDER=protonvpn' 'MEDIA_SERVER=plex'
check 'NordVPN, both media servers, other subnet and countries' 'TIMEZONE=Europe/London' 'VPN_PROVIDER=nordvpn' 'MEDIA_SERVER=both' \
    'MEDIA_SUBNET=10.77.5.0/24' 'VPN_COUNTRIES=Canada,United States' 'MEDIA_ROOT=~/My Media'
[ $bad = 0 ]
